# Salin menjadi .env dan isi. JANGAN commit .env.

HDFS_URI=hdfs://localhost:9000
HADOOP_USER_NAME=hadoop
HDFS_BASE_PATH=/karhutla

# Folder lokal (tanpa spasi)
INBOX_DIR=C:/karhutla-data/inbox
STAGING_DIR=C:/karhutla-data/staging
SPARK_TMP_DIR=C:/karhutla-data/spark-tmp
SERVING_DIR=C:/karhutla-data/serving
DOWNLOADS_DIR=C:/karhutla-data/downloads
SQLITE_PATH=C:/karhutla-data/serving/meta.db
INBOX_SCAN_INTERVAL_SEC=300

SPARK_MASTER=local[4]
SPARK_DRIVER_MEMORY=4g
PYSPARK_PYTHON=

FIRMS_MAP_KEY=
FIRMS_BBOX=95,-11,141,6
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=

BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE=http://localhost:8000/api
NEXT_PUBLIC_BASEMAP_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
NEXT_PUBLIC_BASEMAP_ATTRIBUTION=
GEOJSON_PROVINCES_PATH=backend/app/static/geo/provinces.geojson
MAP_MAX_POINTS=20000
NIFI_URL=http://localhost:8080/nifi
