# PantauApi environment variables (konfigurasi lokal)
# Salin ke .env (backend) dan frontend/.env.local (frontend). Jangan commit file ini beserta kredensial.

# Backend (root repo .env)
HDFS_URI=hdfs://localhost:9000
HDFS_BASE_PATH=/karhutla
HADOOP_USER_NAME=hadoop
SPARK_MASTER=local[4]
SPARK_DRIVER_MEMORY=4g
SPARK_SHUFFLE_PARTITIONS=8

# Frontend (frontend/.env.local)
# Base URL backend FastAPI
NEXT_PUBLIC_API_BASE=http://localhost:8000/api
